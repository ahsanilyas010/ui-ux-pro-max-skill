{{ 'component-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'tile'
-%}
{%- if items.size > 0 -%}
<section class="section" data-section-id="{{ section.id }}" style="--tiles-cols: {{ items.size | at_most: 4 }};">
  <div class="container">
    {%- if s.heading != blank -%}
      <header class="section__header" data-reveal>
        <div class="section__heading">
          {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="section__title">{{ s.heading | escape }}</h2>
        </div>
      </header>
    {%- endif -%}
    <ul class="tiles" role="list" data-reveal>
      {%- for block in items -%}
        <li {{ block.shopify_attributes }}>
          <a class="tile" href="{{ block.settings.link | default: routes.collections_url }}">
            <div class="media">
              {% render 'image', image: block.settings.image, sizes: '(min-width: 990px) 25vw, 50vw', widths: '360,540,720,900', alt: block.settings.heading %}
            </div>
            <div class="tile__content">
              <span class="tile__title">{{ block.settings.heading | escape }}</span>
              {%- if block.settings.subheading != blank -%}<span class="tile__sub">{{ block.settings.subheading | escape }}</span>{%- endif -%}
              <span class="tile__cta">{{ 'general.shop_now' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Category tiles",
  "tag": "div",
  "class": "shopify-section-category-tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "4:5 portrait works best." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Men" },
        { "type": "text", "id": "subheading", "label": "Subheading" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "heading": "Men", "subheading": "Polos, tees, shirts, jackets" } },
        { "type": "tile", "settings": { "heading": "Women", "subheading": "Tops, dresses, outerwear" } },
        { "type": "tile", "settings": { "heading": "Kids", "subheading": "Everyday brands, smaller sizes" } },
        { "type": "tile", "settings": { "heading": "Accessories", "subheading": "Watches, caps, bags, shoes" } }
      ]
    }
  ]
}
{% endschema %}
