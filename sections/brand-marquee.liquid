{{ 'component-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'brand'
-%}
{%- if items.size > 0 -%}
<section class="brands{% if s.inverse %} brands--inverse{% endif %}" data-section-id="{{ section.id }}" aria-label="{{ 'sections.brand_marquee.label' | t }}">
  <div class="container">
    {%- assign heading_text = s.heading | default: 'sections.brand_marquee.default_heading' | t -%}
    {%- if heading_text != blank -%}<p class="eyebrow brands__heading">{{ heading_text | escape }}</p>{%- endif -%}
  </div>
  <div class="marquee-wrap">
    <div class="marquee">
      {%- for i in (1..2) -%}
        <ul class="marquee__track brands__track" role="list" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in items -%}
            {%- liquid
              assign href = block.settings.link
              assign brand_name = block.settings.name
              assign coll = nil
              if href contains '/collections/'
                assign handle = href | split: '/collections/' | last | split: '?' | first | split: '#' | first | split: '/' | first
                assign coll = collections[handle]
              endif
              if coll != blank and coll.url != blank
                assign href = coll.url
                if brand_name == blank
                  assign brand_name = coll.title
                endif
              endif
              if brand_name == blank
                assign brand_name = 'Brand'
              endif
            -%}
            <li class="brands__item" {{ block.shopify_attributes }}>
              {%- if href != blank -%}<a class="brands__link" href="{{ href }}"{% if i == 2 %} tabindex="-1"{% endif %}>{%- else -%}<span class="brands__name">{%- endif -%}
              {%- if block.settings.logo != blank -%}
                <img class="brands__logo" src="{{ block.settings.logo | image_url: height: 64 }}" width="{{ block.settings.logo.aspect_ratio | times: 32 | round }}" height="32" alt="{{ brand_name | escape }}" loading="lazy" decoding="async">
              {%- else -%}
                {{- brand_name | escape -}}
              {%- endif -%}
              {%- if href != blank -%}</a>{%- else -%}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
    <button class="marquee__pause" type="button" data-marquee-toggle aria-pressed="false" aria-label="{{ 'accessibility.pause_marquee' | t }}" data-label-pause="{{ 'accessibility.pause_marquee' | t }}" data-label-play="{{ 'accessibility.play_marquee' | t }}">
      {% render 'icon', name: 'pause', size: 16 %}{% render 'icon', name: 'play', size: 16 %}
    </button>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Brand marquee",
  "tag": "div",
  "class": "shopify-section-brand-marquee",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "inverse", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "info": "Shown as a wordmark when there is no logo. Falls back to the collection title." },
        { "type": "image_picker", "id": "logo", "label": "Logo (optional)" },
        { "type": "url", "id": "link", "label": "Brand collection link", "info": "e.g. /collections/hugo-boss" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand marquee",
      "blocks": [
        { "type": "brand", "settings": { "name": "Hugo Boss", "link": "/collections/hugo-boss" } },
        { "type": "brand", "settings": { "name": "Ralph Lauren", "link": "/collections/ralph-lauren" } },
        { "type": "brand", "settings": { "name": "Lacoste", "link": "/collections/lacoste" } },
        { "type": "brand", "settings": { "name": "Prada", "link": "/collections/prada" } },
        { "type": "brand", "settings": { "name": "Balmain", "link": "/collections/balmain" } },
        { "type": "brand", "settings": { "name": "Pepe Jeans", "link": "/collections/pepe-jeans" } },
        { "type": "brand", "settings": { "name": "Mango", "link": "/collections/mango" } },
        { "type": "brand", "settings": { "name": "Zara", "link": "/collections/zara" } },
        { "type": "brand", "settings": { "name": "Calvin Klein", "link": "/collections/calvin-klein" } },
        { "type": "brand", "settings": { "name": "Adidas", "link": "/collections/adidas" } },
        { "type": "brand", "settings": { "name": "Nike", "link": "/collections/nike" } },
        { "type": "brand", "settings": { "name": "Replay", "link": "/collections/replay" } }
      ]
    }
  ]
}
{% endschema %}
