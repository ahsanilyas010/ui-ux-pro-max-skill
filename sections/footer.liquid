{{ 'component-footer.css' | asset_url | stylesheet_tag }}
<footer class="footer section--inverse" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 320 }}" width="160" height="{{ 160 | divided_by: section.settings.logo.aspect_ratio | round }}" alt="{{ shop.name | escape }}" loading="lazy">
          {%- else -%}
            <span class="footer__wordmark">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
        {%- if settings.whatsapp_number != blank -%}
          <a class="button button--whatsapp button--sm footer__whatsapp" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp', size: 16 %} {{ 'footer.whatsapp_cta' | t }}</a>
        {%- endif -%}
        {%- if section.settings.show_social -%}{% render 'social-icons', class: 'footer__social' %}{%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            {%- if block.settings.menu != blank -%}
              <nav class="footer__col" aria-label="{{ block.settings.heading | default: block.settings.menu.title | escape }}" {{ block.shopify_attributes }}>
                <details class="footer__details" open>
                  <summary class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title | escape }} {% render 'icon', name: 'chevron-down', size: 16, class: 'footer__chevron' %}</summary>
                  <ul class="footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a class="footer__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              </nav>
            {%- endif -%}
          {%- when 'text' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="footer__heading footer__heading--static">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            </div>
          {%- when '@app' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}

      {%- if section.settings.show_newsletter -%}
        <div class="footer__col footer__newsletter">
          <h2 class="footer__heading footer__heading--static">{{ section.settings.newsletter_heading | default: 'footer.newsletter_title' | t }}</h2>
          <p class="footer__text">{{ section.settings.newsletter_text | default: 'footer.newsletter_text' | t }}</p>
          {%- form 'customer', class: 'footer__form', id: 'FooterNewsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,footer">
            {%- if form.posted_successfully? -%}
              <p class="notice notice--success" role="status">{% render 'icon', name: 'check-circle', size: 18 %} {{ 'footer.newsletter_success' | t }}</p>
            {%- else -%}
              <label class="visually-hidden" for="FooterNewsletter-email">{{ 'footer.newsletter_placeholder' | t }}</label>
              <div class="input-group">
                <input id="FooterNewsletter-email" class="field__input" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'footer.newsletter_placeholder' | t }}" autocomplete="email" required>
                <button class="button button--inverse" type="submit">{{ 'footer.newsletter_submit' | t }}</button>
              </div>
              {%- if form.errors -%}<p class="notice notice--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__trust">
      {% render 'trust-row', layout: 'row' %}
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <p class="footer__copyright">{{ 'footer.copyright' | t: year: 'now' | date: '%Y' }}</p>
        {%- if shop.policies.size > 0 -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- if section.settings.show_payment -%}
        <div class="footer__payments">
          <span class="footer__payments-label">{{ 'footer.payments_title' | t }}</span>
          {% render 'payment-icons', class: 'payment-icons--inverse' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "shopify-section-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (light version for dark footer)" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "100% original international brands at outlet prices. Delivered across Pakistan, cash on delivery." },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "First to know" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New drops from Boss, Ralph Lauren, Lacoste and more — plus subscriber-only deals." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment methods", "default": true }
  ],
  "blocks": [
    { "type": "link_list", "name": "Menu column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" } ] },
    { "type": "text", "name": "Text column", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "richtext", "id": "text", "label": "Text" } ] },
    { "type": "@app" }
  ],
  "default": { "blocks": [ { "type": "link_list", "settings": { "heading": "Shop", "menu": "main-menu" } }, { "type": "link_list", "settings": { "heading": "Help", "menu": "quick-links" } } ] }
}
{% endschema %}
