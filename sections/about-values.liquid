{{ 'component-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'value'
-%}
{%- if items.size > 0 -%}
<section class="section section--surface" data-section-id="{{ section.id }}" aria-label="{{ 'sections.about.values_label' | t }}">
  <div class="container">
    {%- if s.heading != blank -%}
      <header class="section__header" data-reveal><h2 class="section__title">{{ s.heading | escape }}</h2></header>
    {%- endif -%}
    <ul class="values" role="list" data-reveal>
      {%- for block in items -%}
        <li class="value" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, size: 28 %}{%- endif -%}
          <h3 class="value__title">{{ block.settings.heading | escape }}</h3>
          <p class="value__text">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "About values",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we stand for" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "none", "label": "None" }, { "value": "badge-check", "label": "Badge check" }, { "value": "truck", "label": "Truck" }, { "value": "exchange", "label": "Exchange" }, { "value": "banknote", "label": "Cash" }, { "value": "whatsapp", "label": "WhatsApp" }, { "value": "package", "label": "Package" }, { "value": "tag", "label": "Tag" } ], "default": "badge-check" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    { "name": "About values", "blocks": [
      { "type": "value", "settings": { "icon": "badge-check", "heading": "100% original", "text": "Every piece is an original from an international label, sourced as export surplus or outlet stock. Never a replica." } },
      { "type": "value", "settings": { "icon": "tag", "heading": "Outlet prices", "text": "No boutique rent, no middle layers. You pay outlet prices for the same label." } },
      { "type": "value", "settings": { "icon": "exchange", "heading": "Fair exchange", "text": "7-day free size exchange. Refund only if the item is not as described." } }
    ] }
  ]
}
{% endschema %}
