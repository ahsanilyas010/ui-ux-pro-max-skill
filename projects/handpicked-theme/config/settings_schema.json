[
  {
    "name": "theme_info",
    "theme_name": "HandPicked Editorial",
    "theme_version": "0.1.0",
    "theme_author": "HandPicked.pk",
    "theme_documentation_url": "https://github.com/ahsanilyas010/ui-ux-pro-max-skill/tree/main/projects/handpicked-theme",
    "theme_support_url": "https://handpicked.pk/pages/contact-us"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page background",
        "default": "#FAFAF9"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (cards, drawers)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface_2",
        "label": "Surface 2 (image frames, muted blocks)",
        "default": "#F5F5F4"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#1C1917"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted text",
        "default": "#57534E"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders / hairlines",
        "default": "#E7E5E4"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (CTAs, links, badges)",
        "default": "#A16207"
      },
      {
        "type": "color",
        "id": "color_accent_ink",
        "label": "Text on accent",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price / sale badge",
        "default": "#B91C1C"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "default": "#15803D"
      },
      {
        "type": "color",
        "id": "color_inverse_bg",
        "label": "Inverse sections background",
        "default": "#1C1917"
      },
      {
        "type": "color",
        "id": "color_inverse_text",
        "label": "Inverse sections text",
        "default": "#FAFAF9"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "playfair_display_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "type_base_size",
        "label": "Base font size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "label": "Heading scale",
        "min": 100,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 110
      },
      {
        "type": "checkbox",
        "id": "type_uppercase_eyebrows",
        "label": "Uppercase eyebrow labels",
        "default": true
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "layout_max_width",
        "label": "Page max width",
        "min": 1200,
        "max": 1680,
        "step": 40,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "range",
        "id": "layout_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 8,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "select",
        "id": "layout_section_spacing",
        "label": "Section spacing",
        "options": [
          {
            "value": "compact",
            "label": "Compact"
          },
          {
            "value": "standard",
            "label": "Standard"
          },
          {
            "value": "spacious",
            "label": "Spacious"
          }
        ],
        "default": "standard"
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "select",
        "id": "button_style",
        "label": "Primary button style",
        "options": [
          {
            "value": "solid-dark",
            "label": "Solid dark"
          },
          {
            "value": "solid-accent",
            "label": "Solid accent"
          }
        ],
        "default": "solid-dark"
      },
      {
        "type": "checkbox",
        "id": "button_uppercase",
        "label": "Uppercase button text",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Image ratio",
        "options": [
          {
            "value": "3/4",
            "label": "Portrait 3:4"
          },
          {
            "value": "1/1",
            "label": "Square"
          },
          {
            "value": "4/5",
            "label": "Portrait 4:5"
          }
        ],
        "default": "3/4"
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Image fit",
        "info": "Use Contain while product photos are mixed-ratio screenshots.",
        "options": [
          {
            "value": "contain",
            "label": "Contain (safe for mixed photos)"
          },
          {
            "value": "cover",
            "label": "Cover (fills frame)"
          }
        ],
        "default": "contain"
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show brand name",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_hover_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_sale_percent",
        "label": "Show % off badge",
        "default": true
      },
      {
        "type": "range",
        "id": "card_low_stock_threshold",
        "label": "Show 'Only N left' at or below",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Quick add with size pills (desktop)",
        "default": true
      },
      {
        "type": "range",
        "id": "card_new_days",
        "label": "'New' badge for products published within (days)",
        "min": 0,
        "max": 60,
        "step": 5,
        "default": 30
      }
    ]
  },
  {
    "name": "Product page",
    "settings": [
      {
        "type": "checkbox",
        "id": "pdp_sticky_bar",
        "label": "Sticky add-to-cart bar on mobile",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "pdp_show_stock",
        "label": "Show per-size stock when low",
        "default": true
      },
      {
        "type": "page",
        "id": "pdp_size_guide_page",
        "label": "Default size guide page"
      },
      {
        "type": "page",
        "id": "pdp_shipping_page",
        "label": "Shipping & returns page"
      },
      {
        "type": "page",
        "id": "pdp_authenticity_page",
        "label": "Authenticity page"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_bar",
        "label": "Show free-delivery progress bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_upsells",
        "label": "Show 'Complete the look' upsells",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Show order note field",
        "default": false
      }
    ]
  },
  {
    "name": "Shipping & payments",
