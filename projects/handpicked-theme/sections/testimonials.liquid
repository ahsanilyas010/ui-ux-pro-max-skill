{{ 'component-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'review'
-%}
{%- if items.size > 0 -%}
<section class="section section--surface" data-section-id="{{ section.id }}" aria-label="{{ 'sections.testimonials.label' | t }}">
  <div class="container">
    <header class="section__header section__header--center" data-reveal>
      <div class="section__heading">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="section__title">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
    </header>
    <ul class="reviews" role="list">
      {%- for block in items -%}
        {%- assign rating = block.settings.rating | default: 5 -%}
        <li class="review" {{ block.shopify_attributes }}>
          <div class="review__stars" role="img" aria-label="{{ 'accessibility.star_reviews' | t: rating: rating }}">
            {%- for i in (1..5) -%}
              {%- if i <= rating -%}{% render 'icon', name: 'star', size: 16, class: 'icon--filled' %}{%- else -%}<span style="opacity:.25">{% render 'icon', name: 'star', size: 16 %}</span>{%- endif -%}
            {%- endfor -%}
          </div>
          <blockquote class="review__quote">“{{ block.settings.quote | escape }}”</blockquote>
          <p class="review__who">
            <span class="review__name">{{ block.settings.name | escape }}{% if block.settings.city != blank %}, {{ block.settings.city | escape }}{% endif %}</span>
            {%- if block.settings.product != blank -%}<span class="review__meta">{{ 'sections.testimonials.bought' | t: product: block.settings.product }}</span>{%- endif -%}
          </p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Testimonials",
  "tag": "div",
  "class": "shopify-section-testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 9,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "product", "label": "Product bought" }
      ]
    }
  ],
  "presets": [ { "name": "Testimonials" } ]
}
{% endschema %}
