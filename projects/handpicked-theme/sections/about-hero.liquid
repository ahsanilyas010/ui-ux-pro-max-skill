{{ 'component-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="section" data-section-id="{{ section.id }}">
  <div class="container about-hero{% if s.image == blank %} about-hero--no-image{% endif %}">
    <div class="about-hero__body" data-reveal>
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="about-hero__title">{{ s.heading | default: page.title | escape }}</h1>
      {%- if s.lead != blank -%}<div class="lead">{{ s.lead }}</div>{%- endif -%}
      {%- if s.cta_label != blank and s.cta_link != blank -%}
        <div><a class="button" href="{{ s.cta_link }}">{{ s.cta_label | escape }}</a></div>
      {%- endif -%}
    </div>
    {%- if s.image != blank -%}
      <div class="about-hero__media media">
        {% render 'image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw', widths: '540,720,900,1080,1296', priority: true %}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "About hero",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About HandPicked" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Original brands, without the boutique mark-up." },
    { "type": "richtext", "id": "lead", "label": "Lead text", "default": "<p>HandPicked is a Pakistani store for 100% original international brands. We buy export-surplus and outlet stock, check every piece, and sell it at outlet prices, delivered to your door with cash on delivery.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [ { "name": "About hero" } ]
}
{% endschema %}
