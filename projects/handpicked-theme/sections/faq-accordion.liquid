{{ 'component-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'question'
  assign group = 'faq-' | append: section.id
-%}
{%- if items.size > 0 -%}
<section class="section" data-section-id="{{ section.id }}" aria-label="{{ 'sections.faq.label' | t }}">
  <div class="container container--narrow">
    <div class="faq">
      {%- if s.heading != blank -%}
        <header class="section__header" data-reveal>
          <div class="section__heading">
            {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
            {%- if s.use_h1 -%}<h1 class="section__title">{{ s.heading | escape }}</h1>{%- else -%}<h2 class="section__title">{{ s.heading | escape }}</h2>{%- endif -%}
          </div>
        </header>
      {%- endif -%}
      <div class="faq__list">
        {%- for block in items -%}
          <details class="accordion" data-accordion-group="{{ group }}" {{ block.shopify_attributes }}>
            <summary class="accordion__summary"><span>{{ block.settings.question | escape }}</span>{% render 'icon', name: 'chevron-down', size: 18 %}</summary>
            <div class="accordion__content faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in items -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | strip_html | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
</section>
{%- endif -%}
{% schema %}
{
  "name": "FAQ accordion",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "use_h1", "label": "Use as the page heading (h1)", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ accordion", "blocks": [
      { "type": "question", "settings": { "question": "Are your products original?", "answer": "<p>Yes. Everything we sell is 100% original from international brands, sourced as export-surplus or outlet stock. We never sell replicas.</p>" } },
      { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>2–4 working days to Karachi, Lahore and Islamabad/Rawalpindi, and 4–7 working days elsewhere in Pakistan.</p>" } }
    ] }
  ]
}
{% endschema %}
