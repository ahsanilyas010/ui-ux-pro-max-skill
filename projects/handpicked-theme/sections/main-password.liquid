<section class="section password" data-section-id="{{ section.id }}">
  <div class="container container--narrow empty-state" style="padding-block: var(--space-12)">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="h2">{%- assign _dk = 'password.title' | t -%}{{ section.settings.heading | default: _dk }}</h1>
    <p class="lead u-text-center">{%- assign _dk = 'password.text' | t -%}{{ section.settings.text | default: _dk }}</p>
    {%- form 'customer', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="notice notice--success" role="status">{{ 'password.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordEmail">{{ 'password.placeholder' | t }}</label>
        <div class="input-group" style="max-width:420px;margin:0 auto">
          <input id="PasswordEmail" class="field__input" type="email" name="contact[email]" placeholder="{{ 'password.placeholder' | t }}" required>
          <button class="button" type="submit">{{ 'password.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="u-mt-8">
      <summary class="link">{{ 'password.login_form_heading' | t }}</summary>
      {%- form 'storefront_password' -%}
        <div class="input-group u-mt-4" style="max-width:420px;margin:var(--space-4) auto 0">
          <label class="visually-hidden" for="Password">{{ 'password.login_form_password' | t }}</label>
          <input id="Password" class="field__input" type="password" name="password" placeholder="{{ 'password.login_form_password' | t }}" required>
          <button class="button button--secondary" type="submit">{{ 'password.login_form_submit' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="notice notice--error u-mt-4">{{ 'password.login_form_error' | t }}</p>{%- endif -%}
      {%- endform -%}
    </details>
    <p class="text-xs u-text-muted">{{ 'password.admin_link' | t }} <a class="link" href="/admin">{{ 'password.admin_login' | t }}</a></p>
  </div>
</section>
{% schema %}
{ "name": "Password page", "tag": "div", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
  { "type": "textarea", "id": "text", "label": "Text", "default": "We’re restocking. Leave your email and we’ll tell you the moment we open." } ] }
{% endschema %}
