{{ 'component-home.css' | asset_url | stylesheet_tag }}
{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign coll = s.collection
  assign limit_n = s.products_to_show | default: 8
  assign is_scroller = false
  if s.layout == 'scroller'
    assign is_scroller = true
  endif
  assign cols = s.columns_desktop | default: 4
-%}
<section class="section{% if s.background == 'surface' %} section--surface{% endif %}" data-section-id="{{ section.id }}" style="--fc-cols: {{ cols }};">
  <div class="container">
    <header class="section__header" data-reveal>
      <div class="section__heading">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="section__title">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="section__subtitle">{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
      {%- if s.show_view_all and coll != blank -%}
        <a class="link link--arrow" href="{{ coll.url }}">{{ 'sections.featured_collection.view_all' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>
      {%- endif -%}
    </header>

    {%- if coll != blank and coll.products.size > 0 -%}
      <ul class="{% if is_scroller %}fc__scroller{% else %}fc__grid product-grid{% endif %}" role="list"{% unless is_scroller %} data-reveal-stagger{% endunless %} aria-label="{{ s.heading | default: 'sections.featured_collection.products_label' | t | escape }}">
        {%- for product in coll.products limit: limit_n -%}
          {%- liquid
            assign card_priority = false
            if s.priority_images and forloop.index <= 4
              assign card_priority = true
            endif
          -%}
          <li>{% render 'product-card', product: product, priority: card_priority, sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 62vw' %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="fc__empty">{{ 'sections.featured_collection.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "class": "shopify-section-featured-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New in" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "grid", "label": "Grid" }, { "value": "scroller", "label": "Swipe row on mobile, grid on desktop" } ], "default": "grid" },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "4" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View all” link", "default": true },
    { "type": "checkbox", "id": "priority_images", "label": "Load first 4 images eagerly", "default": false, "info": "Turn on only when this is the first product section on the page." },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "default", "label": "Page" }, { "value": "surface", "label": "Soft surface" } ], "default": "default" }
  ],
  "presets": [ { "name": "Featured collection" } ]
}
{% endschema %}
