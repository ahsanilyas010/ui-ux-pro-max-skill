{{ 'component-header.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign items = section.blocks | where: 'type', 'item'
  assign style = section.settings.style
-%}
{%- if items.size > 0 -%}
<div class="announcement announcement--{{ style }}{% if section.settings.inverse %} announcement--inverse{% endif %}" data-section-id="{{ section.id }}" role="region" aria-label="Announcements">
  <div class="announcement__inner{% if style == 'marquee' %} marquee-wrap{% else %} container{% endif %}">
    {%- if style == 'marquee' -%}
    <div class="marquee">
      {%- for i in (1..2) -%}
        <ul class="marquee__track announcement__track" role="list" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in items -%}
            {%- for j in (1..2) -%}
            <li class="announcement__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
              {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, size: 14 %}{%- endif -%}
              <span>{{ block.settings.text | escape }}</span>
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
    <button class="marquee__pause" type="button" data-marquee-toggle aria-pressed="false" aria-label="{{ 'accessibility.pause_marquee' | t }}" data-label-pause="{{ 'accessibility.pause_marquee' | t }}" data-label-play="{{ 'accessibility.play_marquee' | t }}">
      {% render 'icon', name: 'pause', size: 16 %}{% render 'icon', name: 'play', size: 16 %}
    </button>
    {%- else -%}
      <ul class="announcement__static" role="list">
        {%- for block in items -%}
          <li class="announcement__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, size: 14 %}{%- endif -%}
            <span>{{ block.settings.text | escape }}</span>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "tag": "aside",
  "class": "shopify-section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "marquee", "label": "Scrolling marquee" }, { "value": "static", "label": "Static (spread out)" } ], "default": "marquee" },
    { "type": "checkbox", "id": "inverse", "label": "Dark background", "default": true }
  ],
  "blocks": [
    {
      "type": "item", "name": "Message", "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery on orders over PKR 3,000" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "badge-check", "label": "Badge check" }, { "value": "banknote", "label": "Cash" }, { "value": "whatsapp", "label": "WhatsApp" }, { "value": "exchange", "label": "Exchange" }, { "value": "sparkle", "label": "Sparkle" } ], "default": "none" }
      ]
    }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [
      { "type": "item", "settings": { "text": "Free delivery on orders over PKR 3,000", "icon": "truck" } },
      { "type": "item", "settings": { "text": "100% original international brands", "icon": "badge-check" } },
      { "type": "item", "settings": { "text": "Cash on delivery · confirmed on WhatsApp", "icon": "banknote" } }
    ] }
  ]
}
{% endschema %}
