{{ 'component-customers.css' | asset_url | stylesheet_tag }}
<section class="customer container" data-section-id="{{ section.id }}">
  <div class="customer__inner customer__inner--wide">
    <div class="u-flex u-between u-center u-wrap u-gap-3">
      <h1 class="customer__title">{{ 'customer.account.title' | t }}</h1>
      <a class="link" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a>
    </div>
    <div class="customer__grid">
      <div>
        <h2 class="h4">{{ 'customer.account.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="customer__table u-mt-4">
              <thead><tr><th>{{ 'customer.orders.order_number' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.payment_status' | t }}</th><th>{{ 'customer.orders.fulfillment_status' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td data-label="{{ 'customer.orders.order_number' | t }}"><a class="link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td data-label="{{ 'customer.orders.date' | t }}">{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td data-label="{{ 'customer.orders.payment_status' | t }}">{{ order.financial_status_label }}</td>
                    <td data-label="{{ 'customer.orders.fulfillment_status' | t }}">{{ order.fulfillment_status_label }}</td>
                    <td data-label="{{ 'customer.orders.total' | t }}">{{ order.total_net_amount | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
          {%- else -%}
            <p class="u-text-muted u-mt-4">{{ 'customer.account.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <aside>
        <h2 class="h4">{{ 'customer.account.details' | t }}</h2>
        <div class="u-mt-4 text-sm">{{ customer.default_address | format_address }}</div>
        <a class="link u-mt-4" style="display:inline-block" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})</a>
      </aside>
    </div>
  </div>
</section>
{% schema %}{ "name": "Customer account", "tag": "div", "settings": [] }{% endschema %}
