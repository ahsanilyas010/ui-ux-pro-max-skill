<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-motion="{{ settings.motion_level }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {%- endif -%}
  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; {{ 'products.facets.filter' | t }}: {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- elsif settings.seo_default_description != blank -%}
    <meta name="description" content="{{ settings.seo_default_description | escape }}">
  {%- endif -%}
  {% render 'meta-tags' %}

  {%- comment -%} Fonts: Shopify-hosted via font_picker (no third-party request). {%- endcomment -%}
  {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% render 'css-variables' %}
  {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

  <script>document.documentElement.classList.replace('no-js', 'js');</script>
  <script>
    window.HP = window.HP || {};
    window.HP.routes = {
      root: {{ routes.root_url | json }},
      cart: {{ routes.cart_url | json }},
      cartAdd: {{ routes.cart_add_url | json }},
      cartChange: {{ routes.cart_change_url | json }},
      cartUpdate: {{ routes.cart_update_url | json }},
      cartClear: {{ routes.cart_clear_url | json }},
      predictiveSearch: {{ routes.predictive_search_url | json }},
      search: {{ routes.search_url | json }},
      productRecommendations: {{ routes.product_recommendations_url | json }},
      collectionsAll: {{ routes.all_products_collection_url | json }}
    };
    window.HP.shop = {
      name: {{ shop.name | json }},
      currency: {{ cart.currency.iso_code | json }},
      moneyFormat: {{ shop.money_format | json }},
      moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
      locale: {{ request.locale.iso_code | json }},
      pageType: {{ request.page_type | json }},
      designMode: {{ request.design_mode | json }}
    };
    window.HP.settings = {
      cartType: {{ settings.cart_type | json }},
      shipping: {
        freeThreshold: {{ settings.shipping_free_threshold | default: 3000 }},
        flatRate: {{ settings.shipping_flat_rate | default: 250 }},
        eta: {{ settings.shipping_eta | json }},
        courier: {{ settings.shipping_courier | json }}
      },
      motion: {
        level: {{ settings.motion_level | json }},
        gsapHome: {{ settings.motion_gsap_home | json }},
        marqueeSpeed: {{ settings.marquee_speed | default: 30 }}
      },
      whatsapp: {{ settings.whatsapp_number | json }},
      lowStockThreshold: {{ settings.card_low_stock_threshold | default: 5 }}
    };
    window.HP.strings = {
      added: {{ 'products.product.added' | t | json }},
      adding: {{ 'products.product.adding' | t | json }},
      addToCart: {{ 'products.product.add_to_cart' | t | json }},
      soldOut: {{ 'products.product.sold_out' | t | json }},
      unavailable: {{ 'products.product.unavailable' | t | json }},
      cartError: {{ 'cart.generic_error' | t | json }},
      qtyError: {{ 'cart.qty_error' | t: count: '[count]' | json }},
      loading: {{ 'general.loading' | t | json }},
      close: {{ 'general.close' | t | json }}
    };
  </script>
  {{ content_for_header }}
</head>

<body class="template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ request.page_type | handle }}-{{ template.suffix | handle }}{% endif %}">
  <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}
  {% sections 'overlay-group' %}

  <div id="HPToastRegion" class="toast-region" aria-live="polite" aria-atomic="true"></div>

  <script src="{{ 'global.js' | asset_url }}" defer></script>
  {%- if settings.motion_level != 'off' -%}
    <script src="{{ 'motion.js' | asset_url }}" defer></script>
  {%- endif -%}
  {% render 'json-ld' %}
</body>
</html>
